# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.example

# Optional overrides. Supply a compatible Keras classifier to enable /api/recognize.
MSL_DATA_DIR=../data/myanmar-sign-language-recognition
MSL_MODEL_PATH=../models/msl_classifier.keras
MSL_SEQUENCE_LENGTH=200

